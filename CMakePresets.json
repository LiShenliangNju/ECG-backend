{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
		    "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
            }
        },
        {
            "name": "Debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "Release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "HostValidation",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "ECG_HOST_VALIDATION": "ON"
            }
        },
        {
            "name": "HILValidation",
            "inherits": "Debug",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "ECG_STAGE2_HIL": "ON",
                "ECG_STAGE2_HIL_INJECT_FILTER_ERROR": "OFF"
            }
        },
        {
            "name": "HILFilterFault",
            "inherits": "HILValidation",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "ECG_STAGE2_HIL_INJECT_FILTER_ERROR": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        },
        {
            "name": "HostValidation",
            "configurePreset": "HostValidation"
        },
        {
            "name": "HILValidation",
            "configurePreset": "HILValidation"
        },
        {
            "name": "HILFilterFault",
            "configurePreset": "HILFilterFault"
        }
    ],
    "testPresets": [
        {
            "name": "HostValidation",
            "configurePreset": "HostValidation",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}